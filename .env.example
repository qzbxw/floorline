# Floorline configuration. Copy to .env and fill in the three required values.
#   cp .env.example .env && chmod 600 .env
# Anything you leave commented out uses the default shown.

# ── Required ────────────────────────────────────────────────────────────────

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram id. Everything from any other account is ignored —
# this bot spends money, so it is single-tenant on purpose. Ask @userinfobot.
TELEGRAM_OWNER_ID=

# Tonnel session: the Telegram WebApp initData string.
#
# It is NOT in Local Storage — the current front end keeps it in memory. Open
# the Tonnel mini app with DevTools attached and either
#   run  copy(Telegram.WebApp.initData)  in the Console, or
#   copy the `user_auth` field out of any POST to gifts2.tonnel.network
#   in the Network tab.
# It looks like: query_id=...&user=%7B%22id%22...&auth_date=...&hash=...
# It expires; when it does, send the new one with /auth instead of editing this.
TONNEL_AUTH_DATA=

# The front-end origin sent with every Tonnel request. Tonnel moved from
# market.tonnel.network to marketplace.tonnel.network; the default matches the
# live one. Set this to https://market.tonnel.network if requests start being
# rejected in a way that looks like an origin check.
#TONNEL_ORIGIN=https://marketplace.tonnel.network

# ── Optional ────────────────────────────────────────────────────────────────

# Cross-market depth. Floorline does not trade on these venues yet, but it
# prices against them: the cheapest ask anywhere caps our exit, and three offers
# well under our entry veto the trade outright. A venue that stops answering
# blocks unattended buying rather than being quietly ignored.

# Portals needs NO configuration: its read endpoints answer anonymously, so the
# comparison is live out of the box. This is only here in case that changes —
# portals.tg → DevTools → Network → any API call → Authorization header.
#PORTALS_AUTH_DATA=

# MRKT: prefer the WebApp initData, because the client exchanges it for a token
# and renews it automatically when the token expires. Open the MRKT mini app in
# Telegram Web → DevTools → Network → the POST to api.tgmrkt.io/api/v1/auth →
# the `data` field of the request body.
#MRKT_INIT_DATA=

# Alternatively paste a ready bearer token (the Authorization header on any
# api.tgmrkt.io call). Simpler to grab, but it cannot self-renew.
#MRKT_TOKEN=

# How long a cross-market floor is reused before it is fetched again.
#CROSS_MARKET_TTL=5m

#DB_PATH=./floorline.db
#LOG_LEVEL=info

# ── Economics ───────────────────────────────────────────────────────────────

# Tonnel charges no sale commission. This purchase referral is added on top of
# the displayed ask (3.79 becomes 3.809); liquidity still sets the entry bar.
#TONNEL_FEE=0.005

# Sale commissions on the other venues. Used only to annotate the comparison
# lines with what their floor would actually pay out.
#PORTALS_FEE=0.02
#MRKT_FEE=0.02

# How far below the best competing ask we assume we must list in order to be
# the one that actually sells.
#UNDERCUT=0.01

# Trade-history window for every liquidity statistic.
#LOOKBACK_DAYS=14
#ATTRIBUTE_LOOKBACK_DAYS=60  # normalized backdrop/symbol/combo premiums

# ── Signal gates (what reaches your chat) ───────────────────────────────────
# Micro-edge profile for Telegram gifts: the threshold is the net edge left
# after fee, undercut and a 0.5–4.5% uncertainty buffer. Raise it for fewer
# signals; 0.01 means at least 1% risk-adjusted profit, not raw spread.

#SIG_MIN_EDGE=0.01          # minimum risk-adjusted net edge
#SIG_MIN_VELOCITY=0.5       # trades per day
#SIG_MIN_SALES=6            # trades within LOOKBACK_DAYS
#SIG_MAX_MAD_RATIO=0.35     # price dispersion ceiling
#SIG_MIN_TREND=0.90         # median(7d)/median(14d); rejects falling knives
#SIG_MIN_PRICE=1            # ignore dust
#SIG_MAX_PRICE=0            # 0 = no ceiling

# ── Auto-buy gates (layered on top of the above) ────────────────────────────
# These do not enable auto-buy. Set the money limits with /limits set, then
# /arm. Without max_ticket and daily_budget the bot refuses to arm at all.

#AUTOBUY_MIN_EDGE=0.03
#AUTOBUY_MIN_VELOCITY=1.0
#AUTOBUY_MIN_SALES=10
#AUTOBUY_MAX_MAD_RATIO=0.25
#AUTOBUY_MIN_TREND=0.95
#AUTOBUY_MIN_TURNOVER=0.60   # distinct physical gifts / trades
#AUTOBUY_MAX_DATA_AGE=5m
#AUTOBUY_MAX_GRAM_MOVE_15M=0.03  # no auto-buy during a 3% move in 15m

# Selling is a separate switch from buying, and it lives in the database rather
# than here so it survives a restart: /resell on|off. It ships OFF — the bot
# buys, then tells you the price it would have asked, and you list it yourself
# with /relist. It gates only the automatic actions; /relist and /exit always
# work by hand.

# New scoring starts in shadow mode: signals and 1/6/24/72h outcomes are
# recorded, but no unattended purchase is allowed. Disable only after /status
# reports at least the configured sample and history window.
#SHADOW_MODE=true
#CALIBRATION_MIN_SIGNALS=200
#CALIBRATION_MIN_DAYS=14

# ── Pollers and rate limiting ───────────────────────────────────────────────
# Durations accept Go syntax ("2s", "1m30s") or a bare number of seconds.

#POLL_FEED=2s               # new listings
#POLL_STATS=60s             # whole-market floor snapshot
#POLL_SALES=25s             # executed trades
#POLL_INVENTORY=60s         # your own gifts and balance
#POLL_GRAM=30s               # GRAM/USDT quote and floor-lag tracker
#GRAM_QUOTE_URL=https://api.gateio.ws/api/v4
#BOOK_CACHE_TTL=15s

# Requests per second against the read host. Raising this is the fastest way
# to get Cloudflare-blocked.
#READ_RPS=2
#READ_BURST=5
#HTTP_TIMEOUT=20s

# ── Telegram account (mini apps) ────────────────────────────────────────────
# MRKT and Portals are HTTPS APIs, but they expect the caller to be a person
# using their mini app. Reading them as a bare API is what got this account
# banned for two weeks. With an account configured, the bot opens each mini app
# itself and mints a fresh, signed initData whenever one is needed.
#
# App id and hash come from https://my.telegram.org → API development tools.
# Then run `floorline login` once and enter the code Telegram sends you.
#TELEGRAM_APP_ID=
#TELEGRAM_APP_HASH=
#TELEGRAM_PHONE=+7...
#TELEGRAM_SESSION=./tgsession.json

# ── Market scanner ──────────────────────────────────────────────────────────
# The feed only ever shows new listings. Most of the market is a gift that has
# been standing at the same price and became interesting because everything
# moved around it — the scanner sweeps that, busiest models first, and only
# considers what fits inside max_ticket and the free balance.
#POLL_SCAN=12m

# Tonnel read front ends, tried in order and rotated on a block. Empty means the
# built-in list (gifts2, gifts3). rs-market.tonnel.network is the marketplace
# web site, not the API — it answers 405 to the API paths — so it is only worth
# putting here if Tonnel actually moves the endpoint there.
# TONNEL_READ_HOSTS=gifts2.tonnel.network,gifts3.tonnel.network

# Route Tonnel through another egress. When every endpoint answers 429 from a
# stopped service on the first request, the refusal is per-IP and no amount of
# backing off helps — a different address is the only fix.
# TONNEL_PROXY=http://user:pass@host:port
