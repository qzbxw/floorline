# Floorline configuration. Copy to .env and fill in the three required values.
#   cp .env.example .env && chmod 600 .env
# Anything you leave commented out uses the default shown.

# ── Required ────────────────────────────────────────────────────────────────

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram id. Everything from any other account is ignored —
# this bot spends money, so it is single-tenant on purpose. Ask @userinfobot.
TELEGRAM_OWNER_ID=

# Tonnel session. Open market.tonnel.network in a desktop browser, then
# DevTools → Application → Local Storage → copy the `authData` value.
# It is a query string starting with `query_id=` or `user=`. It expires;
# when it does, send the new one to the bot with /auth instead of editing this.
TONNEL_AUTH_DATA=

# ── Optional ────────────────────────────────────────────────────────────────

# Portals session, for the cross-market price line on signal cards. Reference
# only — Floorline never trades there. Without it the line is simply omitted.
# From portals-market.com: DevTools → Network → any API call → Authorization header.
#PORTALS_AUTH_DATA=

#DB_PATH=./floorline.db
#LOG_LEVEL=info

# ── Economics ───────────────────────────────────────────────────────────────

# Tonnel charges no sale commission; this is the referral cut only. Because the
# fee is near zero, what gates a trade here is liquidity, not costs.
#TONNEL_FEE=0.005

# Used only to annotate the cross-market comparison.
#PORTALS_FEE=0.02
#MRKT_FEE=0.02

# How far below the best competing ask we assume we must list in order to be
# the one that actually sells.
#UNDERCUT=0.01

# Trade-history window for every liquidity statistic.
#LOOKBACK_DAYS=14

# ── Signal gates (what reaches your chat) ───────────────────────────────────
# Medium profile: roughly 30–60 alerts a day. Raise MIN_EDGE and MIN_VELOCITY
# for fewer, better ones.

#SIG_MIN_EDGE=0.05          # net profit / entry, after the real exit price
#SIG_MIN_VELOCITY=1.0       # trades per day
#SIG_MIN_SALES=10           # trades within LOOKBACK_DAYS
#SIG_MAX_MAD_RATIO=0.35     # price dispersion ceiling
#SIG_MIN_TREND=0.90         # median(7d)/median(14d); rejects falling knives
#SIG_MIN_PRICE=1            # ignore dust
#SIG_MAX_PRICE=0            # 0 = no ceiling

# ── Auto-buy gates (layered on top of the above) ────────────────────────────
# These do not enable auto-buy. Set the money limits with /limits set, then
# /arm. Without max_ticket and daily_budget the bot refuses to arm at all.

#AUTOBUY_MIN_EDGE=0.10
#AUTOBUY_MIN_VELOCITY=2.0
#AUTOBUY_MIN_SALES=20
#AUTOBUY_MIN_SELLERS=4      # distinct sellers — the wash-trading guard
#AUTOBUY_MAX_MAD_RATIO=0.25
#AUTOBUY_MIN_TREND=0.95

# ── Pollers and rate limiting ───────────────────────────────────────────────
# Durations accept Go syntax ("2s", "1m30s") or a bare number of seconds.

#POLL_FEED=2s               # new listings
#POLL_STATS=60s             # whole-market floor snapshot
#POLL_SALES=25s             # executed trades
#POLL_INVENTORY=60s         # your own gifts and balance
#BOOK_CACHE_TTL=15s

# Requests per second against the read host. Raising this is the fastest way
# to get Cloudflare-blocked.
#READ_RPS=2
#READ_BURST=5
#HTTP_TIMEOUT=20s
